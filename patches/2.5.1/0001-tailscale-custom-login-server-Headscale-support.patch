diff --git a/server/service/extensions/tailscale/login_server.go b/server/service/extensions/tailscale/login_server.go
new file mode 100644
index 0000000..785d647
--- /dev/null
+++ b/server/service/extensions/tailscale/login_server.go
@@ -0,0 +1,81 @@
+package tailscale
+
+import (
+	"bufio"
+	"errors"
+	"os"
+	"regexp"
+	"strings"
+)
+
+// LoginServerFile stores the custom control server URL (e.g. Headscale).
+// An empty file, or a file with only comments, means the default Tailscale
+// control server. The same file is read by the /usr/bin/tailscale wrapper
+// installed by nanokvm-tailscale-login-server, so the setting keeps working
+// even with a stock NanoKVM-Server.
+const LoginServerFile = "/etc/kvm/tailscale_login_server"
+
+// Only plain http(s) URLs without query, fragment or credentials are accepted.
+// The value is passed to "sh -c", so the allowed charset must stay shell-safe.
+var loginServerRegexp = regexp.MustCompile(`^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$`)
+
+var ErrInvalidLoginServer = errors.New("invalid login server url")
+
+func normalizeLoginServer(raw string) (string, error) {
+	url := strings.TrimRight(strings.TrimSpace(raw), "/")
+	if url == "" {
+		return "", nil
+	}
+
+	if !loginServerRegexp.MatchString(url) {
+		return "", ErrInvalidLoginServer
+	}
+
+	return url, nil
+}
+
+func readLoginServer() string {
+	file, err := os.Open(LoginServerFile)
+	if err != nil {
+		return ""
+	}
+	defer func() {
+		_ = file.Close()
+	}()
+
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+
+		url, err := normalizeLoginServer(line)
+		if err != nil {
+			return ""
+		}
+		return url
+	}
+
+	return ""
+}
+
+func writeLoginServer(url string) error {
+	content := "# Custom Tailscale control server (e.g. Headscale). Empty = Tailscale default.\n"
+	if url != "" {
+		content += url + "\n"
+	}
+
+	tmp := LoginServerFile + ".tmp"
+	if err := os.WriteFile(tmp, []byte(content), 0o644); err != nil {
+		return err
+	}
+	return os.Rename(tmp, LoginServerFile)
+}
+
+func loginServerArg() string {
+	if url := readLoginServer(); url != "" {
+		return " --login-server=" + url
+	}
+	return ""
+}
diff --git a/server/service/extensions/tailscale/login_server_test.go b/server/service/extensions/tailscale/login_server_test.go
new file mode 100644
index 0000000..9dfd7ac
--- /dev/null
+++ b/server/service/extensions/tailscale/login_server_test.go
@@ -0,0 +1,38 @@
+package tailscale
+
+import "testing"
+
+func TestNormalizeLoginServer(t *testing.T) {
+	ok := map[string]string{
+		"":                                   "",
+		"  ":                                 "",
+		"https://hs.cry.kz":                  "https://hs.cry.kz",
+		" https://hs.cry.kz/ ":               "https://hs.cry.kz",
+		"http://10.0.0.1:8080":               "http://10.0.0.1:8080",
+		"https://example.com/hs/":            "https://example.com/hs",
+		"https://controlplane.tailscale.com": "https://controlplane.tailscale.com",
+	}
+	for in, want := range ok {
+		got, err := normalizeLoginServer(in)
+		if err != nil || got != want {
+			t.Errorf("normalizeLoginServer(%q) = %q, %v; want %q", in, got, err, want)
+		}
+	}
+
+	bad := []string{
+		"hs.cry.kz",
+		"ftp://hs.cry.kz",
+		"https://hs.cry.kz?x=1",
+		"https://hs.cry.kz#a",
+		"https://user:pw@hs.cry.kz",
+		"https://hs.cry.kz;reboot",
+		"https://hs.cry.kz/$(id)",
+		"https://hs.cry.kz `id`",
+		"https://",
+	}
+	for _, in := range bad {
+		if _, err := normalizeLoginServer(in); err == nil {
+			t.Errorf("normalizeLoginServer(%q) accepted invalid url", in)
+		}
+	}
+}
