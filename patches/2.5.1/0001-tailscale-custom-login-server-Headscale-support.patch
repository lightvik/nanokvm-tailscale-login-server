index 48693a1..e9948a9 100644
--- a/server/service/extensions/tailscale/service.go
+++ b/server/service/extensions/tailscale/service.go
@@ -16,6 +16,9 @@ const (
 	TailscalePath  = "/usr/bin/tailscale"
 	TailscaledPath = "/usr/sbin/tailscaled"
 
+	// real binary when /usr/bin/tailscale is the login-server wrapper
+	TailscaleRealPath = "/usr/bin/tailscale.real"
+
 	GoMemLimit int64 = 75
 )
 
@@ -57,6 +60,7 @@ func (s *Service) Uninstall(c *gin.Context) {
 
 	_ = os.Remove(TailscalePath)
 	_ = os.Remove(TailscaledPath)
+	_ = os.Remove(TailscaleRealPath)
 
 	rsp.OkRsp(c)
 	log.Debugf("uninstall tailscale successfully")
@@ -232,8 +236,45 @@ func (s *Service) GetStatus(c *gin.Context) {
 		IP:      ipv4,
 		Name:    status.Self.HostName,
 		Account: status.CurrentTailnet.Name,
+
+		LoginServer: readLoginServer(),
 	}
 
 	rsp.OkRspWithData(c, &data)
 	log.Debugf("get tailscale status successfully")
 }
+
+func (s *Service) GetLoginServer(c *gin.Context) {
+	var rsp proto.Response
+
+	rsp.OkRspWithData(c, &proto.TailscaleLoginServerRsp{
+		Url: readLoginServer(),
+	})
+}
+
+func (s *Service) SetLoginServer(c *gin.Context) {
+	var req proto.TailscaleLoginServerReq
+	var rsp proto.Response
+
+	if err := proto.ParseFormRequest(c, &req); err != nil {
+		rsp.ErrRsp(c, -1, "invalid arguments")
+		return
+	}
+
+	url, err := normalizeLoginServer(req.Url)
+	if err != nil {
+		rsp.ErrRsp(c, -2, "invalid login server url")
+		return
+	}
+
+	if err := writeLoginServer(url); err != nil {
+		rsp.ErrRsp(c, -3, "failed to save login server")
+		log.Errorf("failed to save tailscale login server: %s", err)
+		return
+	}
+
+	rsp.OkRspWithData(c, &proto.TailscaleLoginServerRsp{
+		Url: url,
+	})
+	log.Debugf("set tailscale login server: %q", url)
+}
